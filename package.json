{
  "name": "@oskarlaing/factorio-ui",
  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "main": "dist/src/index.js",
  "typings": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "rollup": "rollup -c",
    "build:cjs": "swc ./src -d ./dist --config-file .swcrc",
    "build:dts": "tsc --declaration --declarationMap --emitDeclarationOnly",
    "copy": "cp ./package.json ./dist/ && cp ./README.md ./dist/ && cp ./LICENSE ./dist/",
    "build": "yarn build:cjs && yarn build:dts",
    "run-tsup": "tsup && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.mts"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0"
  },
  "exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
    "./styles.css": "./dist/index.css"
	},
  "devDependencies": {
    "@ladle/react": "^5.1.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  }
}
